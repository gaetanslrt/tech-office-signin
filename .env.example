# Copy this file to .env and fill it in for local testing.
# On Render these same keys go in the service's Environment tab instead.

# Password for the /admin page. Choose something long.
ADMIN_PASSWORD=SomethingLongAndRandom

# Signs the admin cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Postgres connection string (Neon, Supabase, Render Postgres).
# Leave empty to write to a local SQLite file at data/visits.db instead.
DATABASE_URL=
# Timezone used for the dates students and staff see.
TZ_NAME=America/New_York

# How long a staff login lasts, in hours.
SESSION_HOURS=8
